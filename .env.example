ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5

# LangSmith tracing (every request shows up as a trace: retrieve -> LLM call)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doclens

# Qdrant: leave QDRANT_URL empty to use embedded local storage (no Docker needed)
QDRANT_PATH=./qdrant_data
QDRANT_URL=